# API Scanner Pro v2.0 - Configuration
# Copy this file to .env and customize as needed.

# Shodan API key for security scanning (get yours at https://account.shodan.io)
SHODAN_API_KEY=your_shodan_api_key_here

# Maximum time in seconds to wait for a page scan to complete
SCAN_TIMEOUT=30

# Number of times to retry failed network requests
MAX_RETRIES=3

# Minimum delay in seconds between rate-limited requests
RATE_LIMIT_DELAY=1.0

# Directory for storing scan results and exported reports
OUTPUT_DIR=scan_results

# Run the browser in headless mode (true/false)
HEADLESS=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
